# rl-agent systemd unit (design doc §3.7: crash -> systemd restart; the tc
# backstop keeps enforcing in the kernel while the agent is down).
#
# Install:
#   cp rl-agent.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now rl-agent

[Unit]
Description=rl-agent - per-node HAProxy ingress bandwidth rate limiter
Documentation=https://github.com/ipest-info/haproxy_ingress_rate_limiter
# The agent needs the HAProxy stats socket and the controller network path.
After=network-online.target haproxy.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rl-agent -config /etc/rl-agent/config.yaml
Restart=always
RestartSec=2
# Creates /var/lib/rl-agent (fail-static config cache lives there).
StateDirectory=rl-agent
# CAP_NET_ADMIN: required only for the tc backstop (deploy/tc/backstop.sh);
# map updates via the stats socket need no extra privilege.
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
