# rl-limiter systemd unit（手工安装用的独立示例；一键安装请用
# deploy/bare/rl-limiter.sh，它会从模板生成等价的 unit）。
#
# 部署形态（通用）：一台服务器一个 rl-limiter，不依赖机器上跑的任何
# 服务。监控 = 双网卡设备视图（/proc/net/dev）+ 内核 TCP 计数器
# （/proc/net/snmp）；限速 = instance_quota_mbps（出向目标，网卡口径，
# 闭环收紧客户端侧网卡入向执行）+ 可选的按端口静态入向限速。
#
# 前置：/etc/rl-limiter/config.yaml（由 deploy/config/limiter.example.yaml
# 改出）与 /etc/rl-limiter/rl-limiter.env（网卡接线等环境变量）。
# 推荐直接用 deploy/bare/rl-limiter.sh install（本文件是手工部署参考）。

[Unit]
Description=rl-limiter - server egress rate limiter (NIC-based, tc/HTB)
Documentation=https://github.com/ipest-info/haproxy_ingress_rate_limiter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 限速网卡：不设则自动取默认路由的出口网卡；多网卡机器必须显式指定
# （两网卡部署指向客户端侧那张，见 docs/06 第 6 节）。
# Environment=RL_TC_IFACE=eth0
# 内置 Web 控制台。**读接口无鉴权**，默认只绑 127.0.0.1；要让内网访问
# 必须显式设 RL_CONSOLE_BIND 并用防火墙/安全组限制来源。
# Environment=RL_CONSOLE_PORT=8090
# Environment=RL_CONSOLE_BIND=10.0.0.11
# 写 API（页面/API 修改限额）的令牌：不设则写接口整体 403（页面只读）。
# 生成随机值：openssl rand -hex 24
# Environment=RL_API_TOKEN=
# 监控数据落盘（分钟粒度 JSONL，按天轮转；/metrics 是实时值，这里是历史）。
# 目录由下面的 LogsDirectory 自动创建并授权。
Environment=RL_METRICS_LOG=/var/log/rl-limiter/metrics.jsonl
ExecStart=/usr/local/bin/rl-limiter -c /etc/rl-limiter/config.yaml
Restart=always
RestartSec=2
# 停机上限：服务自身的优雅停机有 10s 兜底（见 __main__ 的收尾超时），
# 这里再给 systemd 一道 15s 的闸——绝不该出现 stop/restart 干等默认
# 90s 的情况。
TimeoutStopSec=15
# 以专用非特权用户运行（tc 权限由下面的 CAP_NET_ADMIN 提供）。
User=rl-limiter
Group=rl-limiter
# tc 下发限速 → CAP_NET_ADMIN（Ambient 让非 root 进程拿到它；要求该能力
# 同时在 BoundingSet 里）。
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
# 文件系统只放开两处：监控数据落盘目录（LogsDirectory 自动创建
# /var/log/rl-limiter 并授权），以及自身配置目录（ReadWritePaths）——
# 控制台/写 API 修改限额要把 quotas/instance_quota_mbps 回写到 config.yaml
# （临时文件 + 原子替换，需要目录写权限；目录与文件的属组要给运行用户，
# 见 docs/09）。不用写 API 可删掉 ReadWritePaths，配置回到完全只读。
LogsDirectory=rl-limiter
ReadWritePaths=/etc/rl-limiter
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# FD 上限：rl-limiter 自己只开少量连接，这个值远够用。
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
