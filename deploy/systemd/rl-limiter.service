# rl-limiter systemd unit（手工安装用的独立示例；一键安装请用
# deploy/bare/rl-limiter.sh，它会从模板生成等价的 unit）。
#
# 部署形态：**与 HAProxy 同机**——每台 HAProxy 服务器上装一个
# rl-limiter，只采本机那台 HAProxy（本机 unix stats socket）。
# **haproxy.cfg 是负载均衡配置的唯一权威**（运维直接编辑 + reload），
# rl-limiter 只读它解析受管 frontend 清单，把 /etc/rl-limiter/config.yaml
# 里 quotas 登记的限额下发到本机网卡的内核 tc（HTB，按监听端口分类），
# 并做秒级带宽监控与持续超限告警。它**不写任何文件**：不改 cfg、不
# reload haproxy。崩溃由 systemd 拉起；限速在内核 tc 上，本服务宕机
# 期间已下发的限速仍然生效，只是监控/告警与限额调整暂停。
#
# 前置条件：
#   1. 本机 haproxy.cfg 的 global 段有
#        stats socket /run/haproxy/admin.sock mode 660 level user
#      defaults 段有 option contstats（长连接的秒级带宽依赖它）。
#   2. 专用用户并加入 haproxy 组（socket 的 mode 660 靠属组授权）：
#        useradd --system --no-create-home --shell /usr/sbin/nologin rl-limiter
#        usermod -aG haproxy rl-limiter
#   3. /etc/rl-limiter/config.yaml（由 deploy/config/limiter.example.yaml
#      改出：cfg_path 指向本机 haproxy.cfg，quotas 按段名登记限额）。
#
# 权限要点：**必须有 CAP_NET_ADMIN**（tc 要操作网络设备）。少了它服务
# 启动即失败——这是刻意的，"静默地没在限速"比起不来危险得多。
#
# 安装：
#   cp rl-limiter.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now rl-limiter

[Unit]
Description=rl-limiter - HAProxy ingress rate limiter (co-located, tc/HTB)
Documentation=https://github.com/ipest-info/haproxy_ingress_rate_limiter
# 同机部署：HAProxy 先起，它的 unix stats socket 才存在。刻意不写
# Requires——haproxy 挂了本服务只是采不到数（打 degraded 告警），不该
# 被连坐停掉。
After=network-online.target haproxy.service
Wants=network-online.target

[Service]
Type=simple
# 限速网卡：不设则自动取默认路由的出口网卡；多网卡机器必须显式指定
# （两网卡部署指向客户端侧那张，见 docs/06 第 6 节）。
# Environment=RL_TC_IFACE=eth0
# 内置 Web 控制台。**读接口无鉴权**，默认只绑 127.0.0.1；要让内网访问
# 必须显式设 RL_CONSOLE_BIND 并用防火墙/安全组限制来源。
# Environment=RL_CONSOLE_PORT=8090
# Environment=RL_CONSOLE_BIND=10.0.0.11
# 写 API（页面/API 修改限额）的令牌：不设则写接口整体 403（页面只读）。
# 生成随机值：openssl rand -hex 24
# Environment=RL_API_TOKEN=
# 监控数据落盘（分钟粒度 JSONL，按天轮转；/metrics 是实时值，这里是历史）。
# 目录由下面的 LogsDirectory 自动创建并授权。
Environment=RL_METRICS_LOG=/var/log/rl-limiter/metrics.jsonl
ExecStart=/usr/local/bin/rl-limiter -c /etc/rl-limiter/config.yaml
Restart=always
RestartSec=2
# 停机上限：服务自身的优雅停机有 10s 兜底（见 __main__ 的收尾超时），
# 这里再给 systemd 一道 15s 的闸——绝不该出现 stop/restart 干等默认
# 90s 的情况。
TimeoutStopSec=15
# 以专用非特权用户运行；读 HAProxy 的 unix stats socket 靠 haproxy 属组。
User=rl-limiter
Group=rl-limiter
SupplementaryGroups=haproxy
# tc 下发限速 → CAP_NET_ADMIN（Ambient 让非 root 进程拿到它；要求该能力
# 同时在 BoundingSet 里）。
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
# 文件系统只放开两处：监控数据落盘目录（LogsDirectory 自动创建
# /var/log/rl-limiter 并授权），以及自身配置目录（ReadWritePaths）——
# 控制台/写 API 修改限额要把 quotas/nic_quota_mbps 回写到 config.yaml
# （临时文件 + 原子替换，需要目录写权限；目录与文件的属组要给运行用户，
# 见 docs/09）。不用写 API 可删掉 ReadWritePaths，配置回到完全只读。
# haproxy.cfg 在任何形态下都只读：rl-limiter 不改 cfg、不 reload haproxy。
LogsDirectory=rl-limiter
ReadWritePaths=/etc/rl-limiter
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# FD 上限：rl-limiter 自己只开少量连接。跟 HAProxy 的 maxconn 无关——
# 那份 LimitNOFILE 要设在 **haproxy 自己的** unit 上，见 docs/08。
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
