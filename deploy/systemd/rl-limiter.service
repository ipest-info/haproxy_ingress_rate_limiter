# rl-limiter systemd unit。
#
# 部署形态：本服务与 HAProxy 分离，独立部署在监控服务器上，通过内网 TCP
# 只读采样多台 HAProxy。崩溃由 systemd 拉起（设计 §3.7）；限速由各台
# HAProxy 自身的 shared bwlim 配置执行，本服务宕机对限速没有任何影响，
# 只是监控/超限告警暂停。
#
# 配置来源二选一（docs/03 §2）：
#   - MySQL 配置库（生产推荐）：取消下方 Environment 行的注释并填入接入
#     参数，-c 参数将被忽略；
#   - 本地 YAML（standalone）：保持默认，编辑 /etc/rl-limiter/config.yaml。
#
# 安装：
#   cp rl-limiter.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now rl-limiter

[Unit]
Description=rl-limiter - centralized HAProxy ingress bandwidth monitor (limits enforced by HAProxy shared bwlim)
Documentation=https://github.com/ipest-info/haproxy_ingress_rate_limiter
# 需要通往各 HAProxy 节点与 MySQL 配置库的网络路径。
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Environment=RL_MYSQL_HOST=10.0.0.5 RL_MYSQL_USER=rl RL_MYSQL_PASSWORD=xxx RL_MYSQL_DB=rl_limiter
# Environment=RL_CONSOLE_PORT=8090   # 内置 Web 控制台（只应经防火墙内访问）
ExecStart=/usr/local/bin/rl-limiter -c /etc/rl-limiter/config.yaml
Restart=always
RestartSec=2
# 注意：无需 CAP_NET_ADMIN——tc 内核兜底（deploy/tc/backstop.sh）部署于
# 各台 HAProxy 机器本机，与本服务无关；本服务只通过内网 TCP 调用
# HAProxy runtime API，无需任何附加特权。
NoNewPrivileges=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
