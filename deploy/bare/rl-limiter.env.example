# rl-limiter 本机环境变量（裸机部署）。装到 /etc/rl-limiter/rl-limiter.env，
# 由 systemd 的 EnvironmentFile 读取。**改完要 systemctl restart rl-limiter**。
#
# 这里只放**本机硬件/网络相关**的环境变量（网卡、控制台端口）。业务配置
# （HAProxy 接线、限额登记）在 /etc/rl-limiter/config.yaml；负载均衡配置
# （监听端口、后端服务器）在 haproxy.cfg——那才是它们的唯一权威。
#
# 语法是 systemd 的 EnvironmentFile 格式，不是 shell：
#   - 不要写 export
#   - 值里有空格才需要引号，一般不用
#   - 不支持变量展开（写 $FOO 不会被替换）

# ---------------------------------------------------------------------------
# 限速（内核 tc）
# ---------------------------------------------------------------------------
# 限速在哪张网卡上执行。不设则自动取默认路由的出口网卡；探测不出来会
# 直接启动失败（宁可起不来，也不要"以为在限速其实没有"）。
#
# **两网卡部署时指向客户端侧那张。** 单网卡时监听端口要避开本机临时端口
# 范围（默认 32768–60999），否则 HAProxy 连后端的临时源端口可能撞上监听
# 端口，把回程流量误算进该 frontend 的限速类——启动时会告警。原委见
# docs/06 第 6 节。
# RL_TC_IFACE=eth0
#
# 设成 - 可以明确关闭限速（只做监控）。生产上别这么设。
# RL_TC_IFACE=-

# 实例监控视图里**入向**数据包统计要采样的网卡。不设则跟随 RL_TC_IFACE。
# RL_NIC=eth0

# ---------------------------------------------------------------------------
# Web 控制台（实时监控 + 限额编辑）
# ---------------------------------------------------------------------------
RL_CONSOLE_PORT=8090
# 控制台**读接口无鉴权**（暴露全量监控数据与运行日志）。默认只绑回环；
# 要让内网访问必须显式改这里，并配合防火墙/安全组限制来源，绝不可暴露
# 公网。绑非回环地址时服务会打一条 warning 留痕。
RL_CONSOLE_BIND=127.0.0.1

# 写 API 的鉴权令牌：控制台页面/API 修改限额（quotas、网卡总限速）时随
# 请求头（Authorization: Bearer <token> 或 X-API-Token）校验。**不设则
# 写接口整体 403**（页面退化为只读，监控不受影响）。
# 生成一个随机值即可，例如：openssl rand -hex 24
# RL_API_TOKEN=

# ---------------------------------------------------------------------------
# 监控数据落盘（历史回查/计费对账用；实时观测走控制台与 /metrics）
# ---------------------------------------------------------------------------
# 分钟粒度 JSONL，按天轮转。目录由 systemd 的 LogsDirectory 自动创建并
# 授权（unit 全只读的前提下唯一放开的目录）。注释掉即不落盘。
RL_METRICS_LOG=/var/log/rl-limiter/metrics.jsonl
# 保留天数（默认 90）。
# RL_METRICS_LOG_DAYS=90

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 日志级别不在这里设——它在 /etc/rl-limiter/config.yaml 的 log_level 字段
# （启动时定型，改完 systemctl restart rl-limiter）。
