# rl-limiter 运行配置（裸机部署）。装到 /etc/rl-limiter/rl-limiter.env，
# 由 systemd 的 EnvironmentFile 读取。**改完要 systemctl restart rl-limiter**。
#
# 语法是 systemd 的 EnvironmentFile 格式，不是 shell：
#   - 不要写 export
#   - 值里有空格才需要引号，一般不用
#   - 不支持变量展开（写 $FOO 不会被替换）

# ---------------------------------------------------------------------------
# 本机身份（必填）
# ---------------------------------------------------------------------------
# 本机在配置库 haproxy_instances 里的实例名。与库里对不上会**启动即失败**
# 并列出已登记的名字——容忍它会让服务"看起来在跑"却什么都采不到。
RL_NODE_NAME=hap-1

# ---------------------------------------------------------------------------
# 配置库（MySQL，跑在 Docker 里；见 deploy/bare/docker-compose.mysql.yml）
# ---------------------------------------------------------------------------
RL_MYSQL_HOST=127.0.0.1
RL_MYSQL_PORT=3306
RL_MYSQL_USER=rl
RL_MYSQL_PASSWORD=rl_pass
RL_MYSQL_DB=rl_limiter
# 配置轮询周期（秒）。控制台上改完，最迟这么久后下发到数据面。
RL_MYSQL_POLL_S=5

# ---------------------------------------------------------------------------
# 限速（内核 tc）
# ---------------------------------------------------------------------------
# 限速在哪张网卡上执行。不设则自动取默认路由的出口网卡；探测不出来会
# 直接启动失败（宁可起不来，也不要"以为在限速其实没有"）。
#
# **两网卡部署时指向客户端侧那张。** 单网卡时监听端口要避开本机临时端口
# 范围（默认 32768–60999），否则 HAProxy 连后端的临时源端口可能撞上监听
# 端口，把回程流量误算进该 frontend 的限速类——启动时会告警。原委见
# docs/06 第 6 节。
# RL_TC_IFACE=eth0
#
# 设成 - 可以明确关闭限速（只做监控与配置下发）。生产上别这么设。
# RL_TC_IFACE=-

# 实例监控视图里**入向**数据包统计要采样的网卡。不设则跟随 RL_TC_IFACE。
# RL_NIC=eth0

# ---------------------------------------------------------------------------
# 配置自动下发（改完立刻生效）
# ---------------------------------------------------------------------------
# 设为本机 haproxy.cfg 路径即启用：库里改监听端口/后端服务器 → rl-limiter
# 渲染进这份 cfg 的受管区块（`# >>> BEGIN rl-limiter managed >>>` 与
# `# <<< END rl-limiter managed <<<` 之间）→ haproxy -c 校验 → 原子替换
# → reload。**标记之外的内容一个字节都不碰。**
#
# 改限额不走这条路——那是 tc class change，连 reload 都不需要。
RL_APPLY_HAPROXY_CFG=/etc/haproxy/haproxy.cfg
# reload 命令。**只从这里读，绝不从配置库读**——否则拿到库的写权限就等于
# 在每台 HAProxy 上远程执行任意命令。
RL_APPLY_RELOAD_CMD=systemctl reload haproxy
# 兜底 reconcile 周期（秒）。变更是事件驱动即时生效，这个只用来纠正
# "有人手改了 cfg"和重试失败的下发。
RL_APPLY_PERIOD_S=30

# ---------------------------------------------------------------------------
# Web 控制台
# ---------------------------------------------------------------------------
RL_CONSOLE_PORT=8090
# **控制台无鉴权且带写接口**（能改限额、改后端、删 frontend）。默认只绑
# 回环；要让内网访问必须显式改这里，并配合防火墙/安全组限制来源，绝不可
# 暴露公网。绑非回环地址时服务会打一条 warning 留痕。
RL_CONSOLE_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 监控数据落库（1 分钟粒度存 7 天、5 分钟粒度存 90 天，支持 90 天回查与
# 95 计费）。设 0 关闭。详见 docs/07。
# RL_METRICS_RETENTION=1
#
# 日志级别**不在这里设**——它是服务级运行参数，存在配置库的 service_config
# 表里（和采样节拍一起），改完随配置轮询热生效，不用重启：
#   UPDATE service_config SET log_level='debug' WHERE id=1;
