# rl-limiter 本机环境变量（裸机部署）。装到 /etc/rl-limiter/rl-limiter.env，
# 由 systemd 的 EnvironmentFile 读取。**改完要 systemctl restart rl-limiter**。
#
# 这里只放**本机硬件/网络相关**的环境变量（网卡、控制台端口）。限额与
# 端口登记在 /etc/rl-limiter/config.yaml（通用形态：不依赖机器上跑的
# 任何服务）。
#
# 语法是 systemd 的 EnvironmentFile 格式，不是 shell：
#   - 不要写 export
#   - 值里有空格才需要引号，一般不用
#   - 不支持变量展开（写 $FOO 不会被替换）

# ---------------------------------------------------------------------------
# 限速（内核 tc）——出厂默认 = 双网卡闭环形态
# ---------------------------------------------------------------------------
# 出厂接线约定：**eth0 面向客户端、eth1 面向后端服务器**。限速方式是
# 入向闭环：**流出方向不做 tc 限速**，按出向带宽动态收紧 eth0 的流入
# （请求方向）带宽，把出向压回登记的目标（原理见 docs/02）。
# 接线在下面两行**显式写死**——排障时看这个文件就知道限速接在哪，
# 不用去记代码默认值。

# 流入方向限速的执行网卡 = **客户端侧**那张（出厂 = eth0）。本机命名
# 不同（如 ens33/enp1s0）时改成实际网卡名——不做自动探测，入向规则
# 放错网卡会误伤后端流量。设 - 明确不做入向限速。
RL_TC_IN_IFACE=eth0

# 后端服务侧网卡（出厂 = eth1）。与上面的客户端侧网卡**相斥**：两项写
# 成同一张卡 rl-limiter 直接启动失败（入向限速会卡住后端回程流量）。
# 本机命名不同时改成实际网卡名；install.sh 的 --client-nic /
# --backend-nic 会替你写这两行。
RL_BACKEND_IFACE=eth1

# 流出方向整形网卡：**-（不限速）**——闭环形态下出向不做 tc。要改用
# 基线的出向 HTB 直接整形（典型：单网卡机器），改成网卡名并把上面的
# RL_TC_IN_IFACE 设为 -；注意单网卡时监听端口要避开本机临时端口范围
# （默认 32768–60999），否则本机主动外连的临时源端口可能撞上监听
# 端口，把回程流量误算进该 frontend 的限速类——启动时会告警，原委见
# docs/02 §5。
RL_TC_IFACE=-

# 实例面板按设备监控的网卡（带宽/数据包/丢包），逗号分隔可多张。
# 不设 = 本机全部**物理**网卡（双网卡机器 eth0/eth1 都在列）；设 -
# 禁用设备统计。
# RL_NIC=eth0,eth1

# ---------------------------------------------------------------------------
# Web 控制台（实时监控 + 限额编辑）
# ---------------------------------------------------------------------------
RL_CONSOLE_PORT=8090
# 监听地址。默认 0.0.0.0（内网同网段可直接打开监控页）；控制台**读
# 接口无鉴权**（暴露全量监控数据与运行日志），必须由防火墙/安全组限制
# 来源，绝不可暴露公网；写接口始终由 RL_API_TOKEN 闸住。只想本机访问
# （配合 SSH 隧道）就改回 127.0.0.1。
RL_CONSOLE_BIND=0.0.0.0

# 写 API 的鉴权令牌：控制台页面/API 修改限额（quotas、实例总限速）时随
# 请求头（Authorization: Bearer <token> 或 X-API-Token）校验。**不设则
# 写接口整体 403**（页面退化为只读，监控不受影响）。
# **必须是高强度随机串**：≥32 位、估算 ≥128 bit、没有重复/顺序/常见词
# 等人为痕迹（规则见 rl_limiter/tokenpolicy.py）。不达标的令牌一律当作
# 没设——写接口禁用，启动日志 ERROR 写明原因。生成：openssl rand -hex 32
# （install.sh --token auto 会自动生成并替你写这一行）。总控（rl-fleet）
# 的 nodes 清单里该节点的 token 要填同一个值。
# RL_API_TOKEN=

# ---------------------------------------------------------------------------
# 监控数据落盘（历史回查/计费对账用；实时观测走控制台与 /metrics）
# ---------------------------------------------------------------------------
# 分钟粒度 JSONL，按天轮转。目录由 systemd 的 LogsDirectory 自动创建并
# 授权（unit 全只读的前提下唯一放开的目录）。注释掉即不落盘。
RL_METRICS_LOG=/var/log/rl-limiter/metrics.jsonl
# 保留天数（默认 90）。
# RL_METRICS_LOG_DAYS=90

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 日志级别不在这里设——它在 /etc/rl-limiter/config.yaml 的 log_level 字段
# （启动时定型，改完 systemctl restart rl-limiter）。
