# rl-limiter systemd unit 模板（裸机部署）。
#
# 由 deploy/bare/rl-limiter.sh install 填入 @占位符@ 后装到
# /etc/systemd/system/rl-limiter.service。别直接改装好的那份——重跑
# install 会覆盖它；要改配置请改 /etc/rl-limiter/config.yaml（业务配置）
# 与 /etc/rl-limiter/rl-limiter.env（本机环境变量）。
#
# 形态（通用）：rl-limiter 直接跑在本机，不依赖机器上跑的任何服务。
# 监控 = 双网卡设备视图 + 内核 TCP 计数器；限速 = 客户端侧网卡的入向
# tc（闭环压出向）。
#
# 权限要点：**必须有 CAP_NET_ADMIN**。限速由内核 tc 执行，tc 要操作网络
# 设备。少了它 rl-limiter 启动即失败——这是刻意的，"静默地没在限速"比
# 起不来危险得多。

[Unit]
Description=rl-limiter - server egress rate limiter (NIC-based, tc/HTB)
Documentation=https://github.com/ipest-info/haproxy_ingress_rate_limiter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=@ENVFILE@
ExecStart=@VENV@/bin/rl-limiter -c @CONF_DIR@/config.yaml
Restart=always
RestartSec=2
# 停机上限：服务自身的优雅停机有 10s 兜底（见 __main__ 的收尾超时），
# 这里再给 systemd 一道 15s 的闸——绝不该出现 stop/restart 干等默认
# 90s 的情况。
TimeoutStopSec=15

# 专用非特权用户（tc 权限由下面的 CAP_NET_ADMIN 提供）。
User=@USER@
Group=@USER@

# tc 下发限速 → CAP_NET_ADMIN。Ambient 让非 root 进程也能拿到它。
# （AmbientCapabilities 要求该能力同时在 CapabilityBoundingSet 里。）
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

# ---- 加固 ---------------------------------------------------------------
# ProtectSystem=strict 全只读，只放开两处：
#   1. 监控数据落盘目录（LogsDirectory 自动创建 /var/log/rl-limiter
#      并授权写入）；
#   2. 自身配置目录（ReadWritePaths）——控制台/写 API 修改限额要把
#      quotas/instance_quota_mbps 回写到 config.yaml（临时文件 + 原子替换，
#      所以需要目录写权限）。不用写 API 的话可以删掉这行，配置就回到
#      完全只读。
LogsDirectory=rl-limiter
ReadWritePaths=@CONF_DIR@
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# FD 上限：rl-limiter 自己只开少量连接（一个 unix socket + 控制台）。
# rl-limiter 自己只开少量连接，这个值远够用。
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
