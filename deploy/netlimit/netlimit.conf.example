# /etc/netlimit.conf —— 本机全网限速的配置（systemd 的 EnvironmentFile）。
#
# 只有一个必填项：整机出向总额度。

# 整机出向总额度，单位 **Mbps**。
#
# **留空 = 不限速**，这是默认——默认值不该成为限制，要限的时候再给一个值。
# 留空与填 0 不是一回事：填 0 会被直接拒绝（0 Mbps 谁也跑不动，那显然是
# 配错了而不是"不想限"）。用 0 兼表"没设"会让打错一个字静默变成不限速。
NETLIMIT_MBPS=1000

# 只限这些网卡（空格分隔）。留空 = 自动发现（推荐）。
# 自动发现会排除 lo / docker0 / br-* / veth* / bond 成员口等，理由见
# netlimit/discover.py。自动判断再周全也有猜错的时候，这里是手动出口。
NETLIMIT_ONLY=

# 在自动发现之外额外排除的网卡（空格分隔）。
NETLIMIT_EXCLUDE=

# 免限端口（空格分隔）。整机限速把本机全部出向都罩住，SSH 也不例外；
# 链路打满时登不上机器是运维事故。默认只免 22。
NETLIMIT_EXEMPT=22

# 多网卡聚合用的 IFB 设备名。单网卡时用不到。
NETLIMIT_IFB=ifb0
